{
  "props": {
    "sectionTitle": {
      "type": "string",
      "description": "Section heading",
      "default": "Simple, Transparent Pricing"
    },
    "sectionSubtitle": {
      "type": "string",
      "description": "Short subtitle below the section title",
      "default": "Choose the plan that works for you"
    },
    "plans": {
      "type": "array",
      "description": "Array of plan objects with name, price, period, features[], ctaText, highlighted (bool)",
      "default": [
        {
          "name": "Starter",
          "price": "$0",
          "period": "/ month",
          "features": ["5 projects", "Basic analytics", "Email support"],
          "ctaText": "Get Started",
          "highlighted": false
        },
        {
          "name": "Pro",
          "price": "$29",
          "period": "/ month",
          "features": ["Unlimited projects", "Advanced analytics", "Priority support", "Custom domain"],
          "ctaText": "Start Free Trial",
          "highlighted": true
        },
        {
          "name": "Enterprise",
          "price": "$99",
          "period": "/ month",
          "features": ["Everything in Pro", "SLA guarantee", "Dedicated account manager", "Custom integrations"],
          "ctaText": "Contact Sales",
          "highlighted": false
        }
      ]
    },
    "primaryColor": {
      "type": "string",
      "description": "Accent / highlight color",
      "default": "#3B82F6"
    },
    "bgColor": {
      "type": "string",
      "description": "Section background",
      "default": "#050813"
    }
  }
}
